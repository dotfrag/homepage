    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pagefind/modular-ui": "^1.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "astro-icon": "^1.2.0",
    "pagefind": "^1.5.2",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
